# MongoDB Atlas connection string (get this from your Atlas cluster's "Connect" button)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolioDB?retryWrites=true&w=majority

# Port for the server to run on
PORT=5000

# Your deployed Netlify site URL(s), comma-separated if more than one
CLIENT_ORIGIN=https://your-portfolio-site.netlify.app,http://localhost:3000
